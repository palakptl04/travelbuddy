# ─────────────────────────────────────────────────────────────────────────────
# TravelBuddy — Environment Variables
#
# Copy this file to .env and fill in real values before running Docker Compose:
#   cp .env.example .env
#
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Flask secret key — used for session signing and CSRF tokens.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL credentials — must match POSTGRES_* vars below.
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# PostgreSQL database name and username (default: travelbuddy / travelbuddy).
POSTGRES_DB=travelbuddy
POSTGRES_USER=travelbuddy

# Flask environment: production | development
FLASK_ENV=production

# JWT settings
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_EXPIRY_SECONDS=3600

# ── Notes ─────────────────────────────────────────────────────────────────────
# DATABASE_URL is constructed automatically by docker-compose.yml from the
# POSTGRES_* vars above. You do NOT need to set it manually when using Compose.
#
# If running Flask locally (outside Docker) against a local Postgres instance,
# you can set DATABASE_URL directly:
#   DATABASE_URL=postgresql://travelbuddy:yourpassword@localhost:5432/travelbuddy
